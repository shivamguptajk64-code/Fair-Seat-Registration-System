{
  "name": "fairseat",
  "version": "1.0.0",
  "description": "FairSeat: High-concurrency fair registration system that prevents overbooking and duplicate allocations under sudden traffic spikes. Prasunex Innovathon 2026.",
  "scripts": {
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node server/src/server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "test:concurrency": "node server/scripts/loadTest.js"
  },
  "keywords": [
    "high-concurrency",
    "ticketing",
    "redis",
    "atomic-locks",
    "fairseat",
    "innovathon-2026"
  ],
  "author": "Shivam Gupta",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
